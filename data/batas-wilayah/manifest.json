{
  "version": "2026-06-15",
  "description": "Boundaries of villages (desa/kelurahan) and districts (kecamatan), one GeoJSON file per regency and level, simplified to about 11 m with shared borders kept together, also across regencies; keyed by the Kemendagri codes of the wilayah set. Arcs where rounding would make a ring cross itself keep up to 9 decimals (villages_with_more_decimals per regency).",
  "status": "partial: every regency of Jawa Tengah (33); regencies listed in `regencies`; others are added on demand (F-035)",
  "source": "Badan Informasi Geospasial, Basis Data Batas Wilayah Administrasi Edisi Juni 2026 (metadata date 2026-06-15), layer BATAS_DESAKEL_AR of https://geoservices.big.go.id/rbi/rest/services/BATASWILAYAH/BATAS_DESAKEL_AR; full-precision downloads kept outside the repository, their content_sha256 per regency here and in sources/batas-wilayah/SOURCE.txt (Kudus kept there as a sample); servers fetch full precision themselves with the presisi command (F-035)",
  "licence": "Informasi Geospasial Dasar, open by law (UU 4/2011 Pasal 12 huruf e and Pasal 42); credit \"Sumber: Badan Informasi Geospasial\" (F-035)",
  "procedure": "tools/converters/batas-wilayah.py fetch <raw_dir> <regency...>, then build <raw_dir> data/wilayah/wilayah.json.gz data/batas-wilayah --tolerance=11",
  "tolerance_m": 11.0,
  "coordinate_decimals": 6,
  "crs": "WGS 84 (EPSG:4326), RFC 7946: outer rings counter-clockwise, holes clockwise",
  "files": {
    "desa/<regency>.geojson.gz": "one Feature per village",
    "kecamatan/<regency>.geojson.gz": "one Feature per district, the union of its villages"
  },
  "fields": {
    "desa": {
      "code": "village code xx.xx.xx.xxxx (wilayah)",
      "name": "official name from wilayah",
      "district": "district code xx.xx.xx",
      "type": "desa or kelurahan (from the code)",
      "status": "boundary status as BIG writes it: Batas Definitif, Hasil Kesepakatan or Batas Indikatif",
      "basis": "regulation the boundary rests on, as BIG writes it (null when none)",
      "area_km2": "area of the full-precision polygon on the WGS 84 ellipsoid"
    },
    "kecamatan": {
      "code": "district code xx.xx.xx",
      "name": "official name from wilayah",
      "villages": "number of villages with a polygon",
      "area_km2": "sum of the villages' full-precision areas"
    }
  },
